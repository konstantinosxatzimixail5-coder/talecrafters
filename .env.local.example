# Copy this file to .env.local and fill in the token.
#
# .env.local is gitignored. Nothing here is needed to run or deploy the site:
# the only thing that reads this token is `npm run seed:sanity`, which pushes
# the repository's content into the dataset. Do not add it to Vercel.
#
# Get one at sanity.io/manage -> your project -> API -> Tokens -> Add API token,
# with the Editor role.
SANITY_WRITE_TOKEN=

# The shared secret the Sanity webhook sends so a publish can purge the site's
# cache. Unlike the token above, this one DOES belong in Vercel: the route at
# /api/revalidate reads it at request time. It authorises one thing, throwing
# away a cache, and gives access to nothing.
#
# Generate one with:  openssl rand -hex 32
# Then set the same value in Vercel and in the webhook's x-revalidate-secret
# header. See src/app/api/revalidate/route.ts for the rest of the setup.
SANITY_REVALIDATE_SECRET=
